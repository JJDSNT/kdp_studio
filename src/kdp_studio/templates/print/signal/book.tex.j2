% ---------------------------------------------------------------- fonts
% Termes for reading, Heros (a Helvetica) in bold for everything that
% orients: labels, heads, numbers. Two faces, two jobs.
\usepackage{fontspec}
\setmainfont{TeX Gyre Termes}[
  Ligatures = TeX,
  Numbers   = {Lining,Proportional},
  SmallCapsFeatures = {Letters=SmallCaps},
]
\newfontfamily\displayfont{TeX Gyre Heros}[Ligatures=TeX, Scale=0.92]
% Letter spacing through the font, never with spaces.
\newfontfamily\labelfont{TeX Gyre Heros}[Ligatures=TeX, Scale=0.92, LetterSpace=9, UprightFont=*-Bold]
\setmonofont{DejaVu Sans Mono}[Scale=MatchLowercase]

% ---------------------------------------------------------------- micro
\usepackage[protrusion=true, expansion=true, tracking=true,
