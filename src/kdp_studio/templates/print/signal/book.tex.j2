\settrimmedsize{((( trim.paper[1] )))}{((( trim.paper[0] )))}{*}
\settrims{0.125in}{0.125in}
((* else *))
\setstocksize{((( trim.paper[1] )))}{((( trim.paper[0] )))}
\settrimmedsize{((( trim.paper[1] )))}{((( trim.paper[0] )))}{*}
((* endif *))
\settypeblocksize{((( trim.typeblock[1] )))}{((( trim.typeblock[0] )))}{*}
\setlrmargins{((( trim.spine_margin )))}{*}{*}
\setulmargins{((( trim.top_margin )))}{*}{*}
