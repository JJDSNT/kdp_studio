% ---------------------------------------------------------------- callouts
\usepackage[most]{tcolorbox}
\usepackage{graphicx}
\usepackage{etoolbox}

\newcommand{\kdplabel}[2][colddark]{%
  {\labelfont\fontsize{7.4}{10}\selectfont\color{#1}\MakeUppercase{#2}}}

% Cold accent, side rule, no background: concept, warning, practice, note,
% challenge.
% A label left alone at the foot of a page says nothing: three lines stay with it.
\newtcolorbox{signalnote}{enhanced, breakable, lines before break=3, colback=white, colframe=cold,
  boxrule=0pt, leftrule=4pt, sharp corners,
  left=10pt, right=8pt, top=8pt, bottom=8pt,
  before skip=13pt, after skip=15pt,
  fontupper=\fontsize{9.7}{13.6}\selectfont}
% A recurring framework: the only framed box in the book.
\newtcolorbox{signalframework}{enhanced, breakable, colback=white, colframe=deep,
  boxrule=1.5pt, sharp corners,
  left=12pt, right=10pt, top=11pt, bottom=11pt,
  before skip=16pt, after skip=16pt,
  fontupper=\fontsize{9.8}{14}\selectfont}

\newenvironment{kdpcallout}[3]{%
  \ifstrequal{#1}{framework}{%
    \begin{signalframework}\kdplabel{#2}\par\vskip 6pt
  }{%
    \begin{signalnote}\kdplabel{#2}\ifstrempty{#3}{}{\ \ {\displayfont\bfseries #3}}\par\vskip 4pt
  }%
  \def\kdpcalloutkind{#1}%
}{%
  \ifdefstring{\kdpcalloutkind}{framework}{\end{signalframework}}{\end{signalnote}}%
}

% ---------------------------------------------------------------- exercises
% Warm accent and a tinted ground: the one object that steps out of the
% narrative, recognisable while leafing through.
\newtcolorbox{signalexercise}{enhanced, breakable, colback=shade, colframe=warm,
  boxrule=0pt, toprule=3pt, sharp corners,
  left=12pt, right=10pt, top=11pt, bottom=11pt,
  before skip=17pt, after skip=17pt,
  fontupper=\fontsize{9.5}{13.4}\selectfont}
\newenvironment{kdpexercise}[2]{%
  \begin{signalexercise}
  \setlist[itemize]{leftmargin=1.1em, itemsep=2pt, topsep=4pt, parsep=0pt,
    label=\textcolor{warmdark}{\rule[0.22ex]{0.38em}{0.38em}}}%
  \setlist[enumerate]{leftmargin=1.5em, itemsep=3pt, topsep=5pt, parsep=0pt,
    label=\textcolor{warmdark}{\displayfont\footnotesize\arabic*.}}%
  \setlength{\parskip}{5pt}\setlength{\parindent}{0pt}%
  \kdplabel[warmdark]{#1}\par\vskip 3pt
  {\displayfont\bfseries\fontsize{14}{18}\selectfont\color{ink}#2}\par\vskip 8pt
}{\end{signalexercise}}
\newcommand{\kdpsublabel}[1]{%
  \par\vskip 7pt{\labelfont\fontsize{7}{10}\selectfont\color{warmdark}\MakeUppercase{#1}}\par\vskip 1pt}

% ---------------------------------------------------------------- prompts
% QR to the companion page, and the prompt printed so it can be read. The QR
% panel never breaks across pages: a split QR does not scan.
\newcommand{\kdppromptlabel}[1]{%
  \par\vskip 6pt{\labelfont\fontsize{6.4}{9}\selectfont\color{warmdark}\MakeUppercase{#1}}\par\vskip 2pt}
\newcommand{\kdppromptsep}{\par\vskip 6pt}
% Monospace is never justified: without hyphenation it only opens holes.
\newcommand{\kdpprompttext}[1]{%
  {\ttfamily\fontsize{8.2}{11.4}\selectfont\color{ink}\raggedright
   \hyphenpenalty=10000 \exhyphenpenalty=10000 #1\par}}
\newcommand{\kdpprompt}[5]{%
  \begin{tcolorbox}[enhanced, breakable, colback=shadelight,
      colframe=warmdark, boxrule=0pt, leftrule=1pt, sharp corners,
      left=10pt, right=10pt, top=9pt, bottom=10pt,
      before skip=11pt, after skip=12pt]
    \noindent
    \ifstrempty{#4}{%
      \kdplabel[warmdark]{#1}\ \ {\displayfont\footnotesize\color{ink}#2}%
    }{%
      % 0.24 of the measure gives a 0.45 mm module for a 33-module symbol
      % with its 4-module quiet zone; below 0.4 mm print-on-demand paper
      % scans unreliably.
      \begin{minipage}[c]{0.24\linewidth}\includegraphics[width=\linewidth]{#4}\end{minipage}\hfill
      \begin{minipage}[c]{0.73\linewidth}\kdplabel[warmdark]{#1}\ \ {\displayfont\footnotesize\color{ink}#2}\end{minipage}
      \par\vskip 6pt
      {\ttfamily\fontsize{7.6}{10}\selectfont\color{deep}\raggedright\hyphenpenalty=10000 #3\par}%
    }%
    \vskip 7pt
    {\color{warm}\rule{\linewidth}{0.5pt}}
    #5
  \end{tcolorbox}}

