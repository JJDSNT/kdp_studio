% ---------------------------------------------------------------- parts
% Part opening: the accent from edge to edge, the words low and to the left.
\usepackage{eso-pic}
\renewcommand*{\partnamefont}{\labelfont\fontsize{10}{14}\selectfont\color{white}}
\renewcommand*{\partnumfont}{\displayfont\bfseries\fontsize{84}{84}\selectfont\color{white}}
\renewcommand*{\parttitlefont}{\displayfont\bfseries\fontsize{27}{31}\selectfont\color{white}}
\renewcommand*{\printparttitle}[1]{\raggedright\parttitlefont #1}
\renewcommand*{\printpartname}{\raggedright\partnamefont\MakeUppercase{((( labels.part|latex )))}\par\vskip 4pt}
\renewcommand*{\partnamenum}{}
\renewcommand*{\printpartnum}{\raggedright\partnumfont\thepart}
\renewcommand*{\midpartskip}{\par\vskip 18pt}
\renewcommand*{\beforepartskip}{%
  \AddToShipoutPictureBG*{\AtPageLowerLeft{\color{cold}%
    \rule[-0.4in]{\dimexpr\paperwidth+0.8in\relax}{\dimexpr\paperheight+0.8in\relax}}}%
