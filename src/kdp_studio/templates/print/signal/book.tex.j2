% ---------------------------------------------------------------- chapters
% The chapter label is printed from the label the renderer passes, not by
% \printchaptername: with \setsecnumdepth{part} memoir treats chapters as
% unnumbered and never calls it -- that is how the number once vanished from
% the page without an error (docs/origin, §10).
\newcommand{\kdpchapterlabel}{}
\makechapterstyle{signal}{%
  \setlength{\beforechapskip}{0.9in}
  \setlength{\midchapskip}{9pt}
  \setlength{\afterchapskip}{30pt}
  \renewcommand*{\chapnamefont}{\labelfont\fontsize{8.6}{11}\selectfont\color{cold}}
  \renewcommand*{\chaptitlefont}{\displayfont\bfseries\fontsize{24}{27}\selectfont\color{deep}}
  \renewcommand*{\printchaptername}{}
  \renewcommand*{\chapternamenum}{}
  \renewcommand*{\printchapternum}{}
  \renewcommand*{\afterchapternum}{}
  \renewcommand*{\printchaptertitle}[1]{%
    {\color{deep}\rule{\textwidth}{3pt}}\par\vskip 10pt
    \ifx\kdpchapterlabel\empty\else
      {\chapnamefont\MakeUppercase{\kdpchapterlabel}}\par\vskip 8pt
    \fi
    \raggedright\chaptitlefont ##1}
  \renewcommand*{\afterchaptertitle}{\par\vskip \afterchapskip}
}
\chapterstyle{signal}
\setsecnumdepth{part}

\newcommand{\kdpchapter}[3]{%
  \renewcommand{\kdpchapterlabel}{#1}%
  \chapter[#3]{#2}%
  \renewcommand{\kdpchapterlabel}{}}
\newcommand{\kdpfrontsection}[2]{%
  \chapter*{#2}%
  \addcontentsline{toc}{chapter}{#1}%
  \markboth{}{#2}}

\setsecheadstyle{\displayfont\bfseries\fontsize{11.4}{15}\selectfont\color{deep}\raggedright}
