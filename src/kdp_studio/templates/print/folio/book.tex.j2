% ---------------------------------------------------------------- parts
% Part opening: a white page, everything on the centre line.
\renewcommand*{\partnamefont}{\labelfont\fontsize{9}{13}\selectfont\color{colddark}}
\renewcommand*{\partnumfont}{\labelfont\fontsize{9}{13}\selectfont\color{colddark}}
\renewcommand*{\parttitlefont}{\normalfont\itshape\fontsize{25}{31}\selectfont\color{deep}}
\renewcommand*{\printparttitle}[1]{\centering\parttitlefont #1}
\renewcommand*{\printpartname}{\centering\partnamefont\MakeUppercase{((( labels.part|latex )))}}
\renewcommand*{\printpartnum}{\partnumfont\thepart}
\renewcommand*{\midpartskip}{\par\vskip 14pt{\color{cold}\rule{0.5pt}{34pt}}\par\vskip 16pt}
\renewcommand*{\beforepartskip}{\null\vskip 2.1in}
\renewcommand*{\afterpartskip}{\vfil\newpage}
\aliaspagestyle{part}{empty}

\newcommand{\kdppart}[2]{\part{#2}}
\newcommand{\kdpunnumberedpart}[2]{%
  \cleartorecto
  \addcontentsline{toc}{part}{#1}%
  \part*{#2}}

% ---------------------------------------------------------------- chapters
% The chapter label is printed from the label the renderer passes, not by
% \printchaptername: with \setsecnumdepth{part} memoir treats chapters as
% unnumbered and never calls it -- that is how the number once vanished from
% the page without an error (docs/origin, §10).
\newcommand{\kdpchapterlabel}{}
\makechapterstyle{folio}{%
  \setlength{\beforechapskip}{1.5in}
  \setlength{\midchapskip}{10pt}
  \setlength{\afterchapskip}{34pt}
  \renewcommand*{\chapnamefont}{\labelfont\fontsize{8}{11}\selectfont\color{colddark}}
  \renewcommand*{\chaptitlefont}{\normalfont\fontsize{20}{25}\selectfont\color{deep}}
  \renewcommand*{\printchaptername}{}
  \renewcommand*{\chapternamenum}{}
  \renewcommand*{\printchapternum}{}
  \renewcommand*{\afterchapternum}{}
  \renewcommand*{\printchaptertitle}[1]{%
    \centering
    \ifx\kdpchapterlabel\empty\else
      {\chapnamefont\MakeUppercase{\kdpchapterlabel}}\par\vskip 12pt
    \fi
    \chaptitlefont ##1}
  \renewcommand*{\afterchaptertitle}{%
    \par\vskip 13pt{\centering\color{cold}\rule{30pt}{0.6pt}\par}\vskip \afterchapskip}
}
\chapterstyle{folio}
\setsecnumdepth{part}

\newcommand{\kdpchapter}[3]{%
  \renewcommand{\kdpchapterlabel}{#1}%
  \chapter[#3]{#2}%
  \renewcommand{\kdpchapterlabel}{}}
\newcommand{\kdpfrontsection}[2]{%
  \chapter*{#2}%
  \addcontentsline{toc}{chapter}{#1}%
  \markboth{}{#2}}

\setsecheadstyle{\normalfont\itshape\fontsize{12.6}{16}\selectfont\color{deep}\raggedright}
\setbeforesecskip{-14pt plus -2pt minus -2pt}
