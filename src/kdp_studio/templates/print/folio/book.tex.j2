% ---------------------------------------------------------------- fonts
% Schola is Century Schoolbook: open, even, made to be read at length. One
% family carries everything; hierarchy comes from italics, small sizes in
% spaced capitals and white space, never from a second face.
\usepackage{fontspec}
\setmainfont{TeX Gyre Schola}[
  Ligatures = TeX,
  Numbers   = {OldStyle,Proportional},
  SmallCapsFeatures = {Letters=SmallCaps},
]
\newfontfamily\displayfont{TeX Gyre Schola}[Ligatures=TeX]
% Letter spacing through the font, never with spaces.
\newfontfamily\labelfont{TeX Gyre Schola}[Ligatures=TeX, LetterSpace=14]
\setmonofont{DejaVu Sans Mono}[Scale=MatchLowercase]

% ---------------------------------------------------------------- micro
\usepackage[protrusion=true, expansion=true, tracking=true,
  factor=1100, stretch=18, shrink=18]{microtype}

% ---------------------------------------------------------------- page
% Bleed: page = trim + 0.125in at top, foot and outer edge; nothing at the
% spine.
((* if bleed *))
\setstocksize{\dimexpr((( trim.paper[1] )))+0.25in\relax}{\dimexpr((( trim.paper[0] )))+0.125in\relax}
\settrimmedsize{((( trim.paper[1] )))}{((( trim.paper[0] )))}{*}
\settrims{0.125in}{0.125in}
((* else *))
\setstocksize{((( trim.paper[1] )))}{((( trim.paper[0] )))}
\settrimmedsize{((( trim.paper[1] )))}{((( trim.paper[0] )))}{*}
((* endif *))
\settypeblocksize{((( trim.typeblock[1] )))}{((( trim.typeblock[0] )))}{*}
\setlrmargins{((( trim.spine_margin )))}{*}{*}
\setulmargins{((( trim.top_margin )))}{*}{*}
\setheadfoot{\onelineskip}{2.2\onelineskip}
\setheaderspaces{*}{1.6\onelineskip}{*}
\checkandfixthelayout

\setSingleSpace{1.045}
\SingleSpacing
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
\brokenpenalty=10000
\raggedbottom
\frenchspacing
\setlength{\emergencystretch}{2em}

